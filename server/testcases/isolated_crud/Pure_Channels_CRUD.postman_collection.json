{
  "info": {
    "name": "Pure CRUD - Channels Only",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "DB Reset for Tests",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/dev/reset",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "dev",
            "reset"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Channels",
      "item": [
        {
          "name": "GET /channels - returns 200 with array of channels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/channels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC045 - GET /channels - returns 200 with array of channels\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "POST /channels - successful channel creation returns 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/channels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"qa-testing-{{$randomInt}}\",\n  \"description\": \"QA test channel\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC047 - POST /channels - successful channel creation returns 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "PATCH /channels/:id - successful channel update returns 200",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels",
                "{{channelId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC050 - PATCH /channels/:id - successful channel update returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "DELETE /channels/:id - successful delete returns 200",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/channels/{{channelId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "channels",
                "{{channelId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"TC052 - DELETE /channels/:id - successful delete returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": "test-token"
    },
    {
      "key": "userId",
      "value": "u-2"
    },
    {
      "key": "connectionId",
      "value": "conn-1"
    },
    {
      "key": "channelId",
      "value": "c-1"
    }
  ]
}