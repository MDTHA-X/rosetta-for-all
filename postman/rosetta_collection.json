  "item": [
    {
      "name": "01. System Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Health status is ok', function () { pm.expect(json.status).to.eql('ok'); });",
              "pm.test('Service name matches', function () { pm.expect(json.service).to.eql('Rosetta For All API'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Auth - Invalid Credentials",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"invalid_user\",\"password\":\"wrong_pass\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });",
              "const json = pm.response.json();",
              "pm.test('Returns invalid credentials error', function () { pm.expect(json.error).to.eql('Invalid credentials'); });"
            ]
          }
        }
      ]
    },
    {
