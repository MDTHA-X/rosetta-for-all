    {
      "name": "13. Rounds - Get Pairings for Round 1",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/rounds?tournament_id={{tournamentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["rounds"],
          "query": [{ "key": "tournament_id", "value": "{{tournamentId}}" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Round 1 exists with 2 pairings boards', function () {",
              "  const round1 = json.find(r => r.number === 1);",
              "  pm.expect(round1).to.exist;",
              "  pm.expect(round1.pairings.length).to.eql(2);",
              "  pm.environment.set('pairingId', round1.pairings[0].id);",
              "  pm.environment.set('pairingId2', round1.pairings[1].id);",
              "});"
            ]
          }
        }
      ]
