    {
      "name": "17. Standings - Dynamic Tiebreak Standings",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/rounds?tournament_id={{tournamentId}}&standings=true",
          "host": ["{{baseUrl}}"],
          "path": ["rounds"],
          "query": [
            { "key": "tournament_id", "value": "{{tournamentId}}" },
            { "key": "standings", "value": "true" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "pm.test('Standings calculated for all 4 players', function () { pm.expect(json.standings.length).to.eql(4); });",
              "pm.test('First rank has highest score (1.0)', function () { pm.expect(json.standings[0].score).to.eql(1); });",
              "pm.test('Tiebreak fields present', function () {",
              "  const s = json.standings[0];",
              "  pm.expect(s).to.have.property('buchholz');",
              "  pm.expect(s).to.have.property('sonnebornBerger');",
              "  pm.expect(s).to.have.property('koya');",
              "});"
            ]
          }
        }
      ]
